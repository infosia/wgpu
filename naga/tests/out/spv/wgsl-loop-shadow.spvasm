; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 70
OpCapability Shader
OpExtension "SPV_KHR_storage_buffer_storage_class"
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %10 "main"
OpExecutionMode %10 LocalSize 1 1 1
%3 = OpString "loop-shadow.wgsl"
OpSource Unknown 0 %3 "struct Output {
    outer: u32,
    body: u32,
    continuing_value: u32,
    iterations: u32,
}

@group(0) @binding(0)
var<storage, read_write> output: Output;

@compute @workgroup_size(1)
fn main() {
    var my_idx = 7u;
    output.outer = my_idx;

    loop {
        var my_idx = output.iterations + 10u;
        output.body = my_idx;

        continuing {
            var my_idx = output.iterations + 20u;
            output.continuing_value = my_idx;
            output.iterations += 1u;
            break if my_idx >= 21u;
        }
    }
}
"
